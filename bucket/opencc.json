{
    "version": "1.4.2",
    "description": "A precise conversion engine for Traditional Chinese, Simplified Chinese, Japanese Kanji, variants, and regional wording across Mainland China, Taiwan, and Hong Kong.",
    "homepage": "https://opencc.byvoid.com",
    "license": "Apache-2.0",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/BYVoid/OpenCC/releases/download/ver.1.4.2/OpenCC-1.4.2-windows-x64-portable.zip",
            "hash": "dab0142ff6401219a5e556cee215323753eeac38752dde4cfddf8035746605f1"
        }
    },
    "bin": [
        "bin\\opencc.exe",
        "bin\\opencc_dict.exe",
        "bin\\opencc_phrase_extract.exe"
    ],
    "checkver": {
        "github": "https://github.com/BYVoid/OpenCC",
        "regex": "ver\\.(\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/BYVoid/OpenCC/releases/download/ver.$version/OpenCC-$version-windows-x64-portable.zip"
            }
        },
