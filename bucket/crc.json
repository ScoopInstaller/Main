            "hash": "2f3ffed8e72a9b8b8363d664eed54db6bee3154a24dd28ca4802ff1a34c2ec01",
            "installer": {
                "script": "Expand-MsiArchive -Path \"$dir\\crc-windows-amd64.msi\" -DestinationPath $dir -ExtractDir 'PFiles64\\Red Hat OpenShift Local' -Removal"
