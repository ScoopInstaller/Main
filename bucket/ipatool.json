            "hash": "d7494be51097e4ab132c5f2453a1ccafa56fffe5379a1ac0366e0997bbda6df8"
        },
        "arm64": {
            "url": "https://github.com/majd/ipatool/releases/download/v2.5.0/ipatool-2.5.0-windows-arm64.tar.gz",
            "hash": "d55c819ffc43a78e6d97b4a2a65d84eb108751bd968694d52b9f14671db961ab"
        }
    },
    "extract_dir": "bin",
    "pre_install": "Get-ChildItem \"$dir\\ipatool-*.exe\" | Select-Object -First 1 | Rename-Item -NewName \"ipatool.exe\"",
