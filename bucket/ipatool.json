        },
        "arm64": {
            "url": "https://github.com/majd/ipatool/releases/download/v2.8.0/ipatool-2.8.0-windows-arm64.tar.gz",
            "hash": "0c3c5eba3ad92d385266e048b9666b97cd27ea4bfb22861e47ded406f3db8acb"
        }
    },
    "extract_dir": "bin",
