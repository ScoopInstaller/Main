{
    "version": "3.13.0",
    "description": "SDK for the Dart programming language",
    "homepage": "https://dart.dev/",
    "license": "BSD-3-Clause",
    "extract_dir": "dart-sdk",
    "env_add_path": "bin",
    "architecture": {
        "64bit": {
            "url": "https://storage.googleapis.com/dart-archive/channels/stable/release/3.13.0/sdk/dartsdk-windows-x64-release.zip",
            "hash": "8480a527e621e9b06f1121cb4f56204e5c2b07851021cbe63965399de4d7f407"
        }
    },
    "checkver": {
        "url": "https://storage.googleapis.com/dart-archive/channels/stable/release/latest/VERSION",
