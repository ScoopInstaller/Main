{
    "version": "8.0.4",
    "description": "Powerful Shell Completions for PowerShell and other shells, powered by Rust and Lua",
    "homepage": "https://pscompletions.abgox.com",
    "license": "MIT",
    "notes": [
        "PowerShell: Import-Module PSCompletions  (add to $PROFILE to auto-import)",
        "bash: source \"<dir>/PSCompletions.bash\"  (add to ~/.bashrc)",
        "zsh: source \"<dir>/PSCompletions.zsh\"  (add to ~/.zshrc)",
        "fish: ln -s \"<dir>/PSCompletions.fish\" ~/.config/fish/conf.d/PSCompletions.fish",
        "Docs: https://pscompletions.abgox.com/docs/shells"
    ],
    "url": "https://cdn.powershellgallery.com/packages/pscompletions.8.0.4.nupkg",
    "hash": "7665d51508fc9ef432a4ffbfd4e3c839f4f3888944faada4cc36dee579b6b766",
    "pre_install": "Remove-Item \"$dir\\_rels\", \"$dir\\package\", \"$dir\\*Content*.xml\" -Recurse",
    "env_set": {
        "PSCOMPLETIONS_DATA_DIR": "$dir\\data"
    },
    "psmodule": {
        "name": "PSCompletions"
    },
    "persist": "data",
    "checkver": {
        "url": "https://www.powershellgallery.com/packages/PSCompletions",
        "regex": "<h2>([\\d.]+)</h2>"
    },
    "autoupdate": {
        "url": "https://cdn.powershellgallery.com/packages/pscompletions.$version.nupkg"
    }
}
