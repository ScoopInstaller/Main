            "hash": "216c049681598452b5692c01ce8c2ec43659fd74f6e536ce5346815f8902f036"
        },
        "32bit": {
            "url": "https://mirror.racket-lang.org/installers/9.3/racket-minimal-9.3-i386-win32.exe#/dl.7z",
            "hash": "31956c264323d5104da8ae307cd66cec4df6bf3e9d32549edf3a64bda48c08a0"
        },
        "arm64": {
            "url": "https://mirror.racket-lang.org/installers/9.3/racket-minimal-9.3-arm64-win32.exe#/dl.7z",
            "hash": "90512e34495809b71411a3afa94edd8491aa39a8a69ac5170f3c526122aa61f5"
        }
    },
    "bin": [
        "racket.exe",
        "raco.exe"
    ],
    "checkver": {
        "url": "https://download.racket-lang.org/",
        "regex": "Version ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://mirror.racket-lang.org/installers/$version/racket-minimal-$version-x86_64-win32.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://mirror.racket-lang.org/installers/$version/racket-minimal-$version-i386-win32.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://mirror.racket-lang.org/installers/$version/racket-minimal-$version-arm64-win32.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://download.racket-lang.org/releases/$version/",
            "regex": "$basenameNoExt.*?$sha256"
        }
    }
}
