{
    "version": "3.9.7",
    "description": "High-performance coordination service for distributed applications",
    "homepage": "https://zookeeper.apache.org/",
    "license": "Apache-2.0",
    "suggest": {
        "JDK": "java/openjdk"
    },
    "url": "https://downloads.apache.org/zookeeper/zookeeper-3.9.7/apache-zookeeper-3.9.7-bin.tar.gz",
    "hash": "sha512:69ce6bf0b6df9a9ecdf080bdc15758eef97ef176a88f1408214f2327fe6e5349fedf738031977e6fc2f52cb636b45779653389a6bfda75be9c82dd3e72f24f25",
    "extract_dir": "apache-zookeeper-3.9.7-bin",
    "post_install": [
        "$dataDirPath = (\"$dir\\data\").replace('\\', '\\\\')",
        "(Get-Content \"$dir\\conf\\zoo_sample.cfg\") -Replace '^dataDir=(.+)$', \"dataDir=$dataDirPath\" | Set-Content \"$dir\\conf\\zoo.cfg\" -Encoding Ascii"
    ],
    "bin": [
        "bin\\zkServer.cmd",
        "bin\\zkCli.cmd"
    ],
    "persist": "data",
    "checkver": {
        "url": "https://downloads.apache.org/zookeeper/",
        "regex": "zookeeper-([\\d.]+)/",
        "reverse": true
    },
    "autoupdate": {
        "url": "https://downloads.apache.org/zookeeper/zookeeper-$version/apache-zookeeper-$version-bin.tar.gz",
        "hash": {
            "url": "$url.sha512"
        },
        "extract_dir": "apache-zookeeper-$version-bin"
    }
}
