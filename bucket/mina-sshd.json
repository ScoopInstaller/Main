{
    "version": "2.20.1",
    "description": "A 100% pure java library to support the SSH protocols on both the client and server side.",
    "homepage": "https://mina.apache.org/sshd-project/",
    "license": "Apache-2.0",
    "suggest": {
        "JDK": "java/openjdk"
    },
    "url": "https://dlcdn.apache.org/mina/sshd/2.20.1/apache-sshd-2.20.1.tar.gz",
    "hash": "sha512:47a00c32d970a9065c980e1880a6dbd99856cebb3792eee01485c8e2b8d7f49ec721a27a39b3f2a783f2e466ef6b17c9e5c3490947ccc8b49c38cd75b4b96741",
    "extract_dir": "apache-sshd-2.20.1",
    "bin": [
        "bin\\scp.bat",
        "bin\\sftp.bat",
        "bin\\ssh-keyscan.bat",
        "bin\\ssh.bat",
        "bin\\sshd.bat"
    ],
    "checkver": {
        "url": "https://mina.apache.org/sshd-project/downloads.html",
        "regex": "Latest SSHD Release: (\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://dlcdn.apache.org/mina/sshd/$version/apache-sshd-$version.tar.gz",
        "hash": {
            "url": "$url.sha512"
        },
        "extract_dir": "apache-sshd-$version"
    }
}
