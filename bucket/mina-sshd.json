{
    "version": "2.20.0",
    "description": "A 100% pure java library to support the SSH protocols on both the client and server side.",
    "homepage": "https://mina.apache.org/sshd-project/",
    "license": "Apache-2.0",
    "suggest": {
        "JDK": "java/openjdk"
    },
    "url": "https://dlcdn.apache.org/mina/sshd/2.20.0/apache-sshd-2.20.0.tar.gz",
    "hash": "sha512:3d4812391535afe931c1b8ec449ad9a75fabd134e320c0a270f216ea02ef72d9643f71208d615b3dcbae9e6aa74be5e81904e9dae8a79ccadb831f38e8534fb3",
    "extract_dir": "apache-sshd-2.20.0",
    "bin": [
        "bin\\scp.bat",
        "bin\\sftp.bat",
        "bin\\ssh-keyscan.bat",
        "bin\\ssh.bat",
        "bin\\sshd.bat"
    ],
    "checkver": {
        "url": "https://mina.apache.org/sshd-project/downloads.html",
        "regex": "Latest SSHD Release: (\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://dlcdn.apache.org/mina/sshd/$version/apache-sshd-$version.tar.gz",
        "hash": {
            "url": "$url.sha512"
        },
        "extract_dir": "apache-sshd-$version"
    }
}
