{
    "version": "8.6.0",
    "description": "A popular general-purpose scripting language that is especially suited to web development. (thread safe)",
    "homepage": "https://www.php.net/",
    "license": "PHP-3.01",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.6.0-Win32-vs18-x64.zip",
            "hash": "daf3639addc12197bfea7aff8797edc78939f5d8809e0cced49d899347c337b0"
        },
        "32bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.6.0-Win32-vs18-x86.zip",
            "hash": "7c6c141dfb7ed12b4ea834effa2ac2138161141980c993c32fbc4128e443d77c"
        }
    },
    "pre_install": [
        "# Create directory for custom PHP configuration",
        "if (!(Test-Path \"$dir\\cli\\conf.d\")) {",
        "    (New-Item -Type directory \"$dir\\cli\\conf.d\") | Out-Null",
        "}"
    ],
    "post_install": [
        "# Enable extensions to be found in installation-relative folder (the default is to search C:/php)",
        "(Get-Content \"$dir\\cli\\php.ini\") | % { $_ -replace ';\\s?(extension_dir = \"ext\")', '$1' } | Set-Content \"$dir\\cli\\php.ini\""
    ],
    "bin": [
        "php.exe",
        "php-cgi.exe",
        "phpdbg.exe"
    ],
    "env_set": {
        "PHP_INI_SCAN_DIR": "$dir\\cli;$dir\\cli\\conf.d;"
    },
    "persist": [
        "cli",
        [
            "php.ini-production",
            "cli\\php.ini"
        ]
    ],
    "checkver": {
        "url": "https://downloads.php.net/~windows/releases/releases.json",
        "regex": "(?i)php-(\\d+(?:\\.\\d+)+(?:-\\d+)?)-Win32-(?<vs>VS\\d+)-x64.zip",
        "reverse": true
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-Win32-$matchVs-x64.zip"
            },
            "32bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-Win32-$matchVs-x86.zip"
            }
        },
        "hash": {
            "url": "https://www.php.net/backend/win-releases.json",
            "jsonpath": "$..[?(@.path == '$basename')].sha256"
        }
    }
}
