            "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v7.2.143/CLIProxyAPI_7.2.143_windows_amd64.zip",
            "hash": "508d2827f56ca3677b224255d2d91b93a0b4f1c7787b75ac6cd897e76e6afe54"
        },
        "arm64": {
            "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v7.2.143/CLIProxyAPI_7.2.143_windows_aarch64.zip",
            "hash": "73b412c8f639b34194db08eac28475f22d9b5db3f465fc8e6b0c9811b4f6dafe"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -Path \"$persist_dir\\config.yaml\")) {",
        "    Copy-Item -Path \"$dir\\config.example.yaml\" -Destination \"$dir\\config.yaml\"",
        "}"
    ],
    "bin": [
        [
            "cli-proxy-api.exe",
            "cli-proxy-api",
            "--config \"$persist_dir\\config.yaml\""
