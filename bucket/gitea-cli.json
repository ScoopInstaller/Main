{
    "version": "1.0.0",
    "description": "The rewritten Gitea command line client (successor of 'tea').",
    "homepage": "https://gitea.com/gitea/cli",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://gitea.com/gitea/cli/releases/download/v1.0.0/gitea-cli-1.0.0-windows-amd64.exe.xz",
            "hash": "7d0a5f8bbfa4ad6cf1c9d68dd761426052d00e7e38a140195fa4f1fe15a3d138"
        },
        "arm64": {
            "url": "https://gitea.com/gitea/cli/releases/download/v1.0.0/gitea-cli-1.0.0-windows-arm64.exe.xz",
            "hash": "b20f016882d2642e3efd35697241b8f62ccabd4f7fac0c54abb15c1e3a35a048"
        }
    },
    "pre_install": "Get-ChildItem -LiteralPath $dir -Filter 'gitea-cli-*.exe' -File | Select-Object -First 1 | Rename-Item -NewName 'gt.exe'",
    "bin": "gt.exe",
    "checkver": {
        "url": "https://gitea.com/gitea/cli/releases/latest",
        "regex": "/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gitea.com/gitea/cli/releases/download/v$version/gitea-cli-$version-windows-amd64.exe.xz"
            },
            "arm64": {
                "url": "https://gitea.com/gitea/cli/releases/download/v$version/gitea-cli-$version-windows-arm64.exe.xz"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
