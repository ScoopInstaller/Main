            "hash": "4d002e330a0f703625aa5ccbc37e96f8f824413e163bfc7336774aabd2c3a412",
            "extract_dir": "llvm-mingw-20261117-ucrt-x86_64"
        },
        "32bit": {
            "url": "https://github.com/mstorsjo/llvm-mingw/releases/download/20261117/llvm-mingw-20261117-ucrt-i686.zip",
            "hash": "c1806817728ff4bdf780e21365397fc9f427ade813ca097bda6ae7e4a9803cb4",
            "extract_dir": "llvm-mingw-20261117-ucrt-i686"
        },
        "arm64": {
