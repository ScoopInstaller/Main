            "extract_dir": "coreutils-0.13.0-x86_64-pc-windows-msvc"
        },
        "32bit": {
            "url": "https://github.com/uutils/coreutils/releases/download/0.13.0/coreutils-0.13.0-i686-pc-windows-msvc.zip",
            "hash": "ece3c5f117143904e3864b1f59895cd38951525246d7a5e4f0cb1a40852a7c33",
            "extract_dir": "coreutils-0.13.0-i686-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/uutils/coreutils/releases/download/0.13.0/coreutils-0.13.0-aarch64-pc-windows-msvc.zip",
            "hash": "ce8827a11efc8d05f0060b49b4c50a9a59cfa57d1a9a3ed0724b5ab0cb62a2f0",
