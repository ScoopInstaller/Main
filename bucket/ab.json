    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://fossies.org/windows/www/httpd-2.4.69-261002-Win64-VS18.zip",
            "hash": "9b47a2363a71fef6209c88e79743db81311e1753c4564e007141934123132c10"
        }
    },
    "extract_dir": "Apache24",
    "pre_install": "Remove-Item \"$dir\\*\" -Exclude ab.exe,abs.exe,libcrypto*.dll,libssl*.dll,NOTICE.txt,LICENSE.txt -Recurse -Force",
    "bin": [
        "bin\\ab.exe",
        "bin\\abs.exe"
    ],
    "checkver": {
        "url": "https://fossies.org/windows/www/",
