    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://fossies.org/windows/www/httpd-$version-$matchDate-$matchArch-$matchVs.zip"
            }
        },
        "hash": {
            "url": "$url_fossies.sha256"
        },
        "extract_dir": "Apache$majorVersion$minorVersion"
    }
}
