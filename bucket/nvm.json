{
    "version": "2.0.0",
    "description": "A node.js version management utility for Windows.",
    "homepage": "https://github.com/nvm-windows/nvm",
    "license": "MIT",
    "notes": [
        "NVM for Windows v2 has been fully rewritten for modern workflows.",
        "For more details, please refer to: https://docs.nvm-windows.com/features/newv2/",
        "",
        "v2 introduces significant changes to how data and settings are stored. Scoop can no longer persist them.",
        "Additionally, as Scoop does not run the installer, built-in migration scripts will not be run.",
        "You may need to migrate them manually. Previously persisted data remains stored at: $persist_dir.",
        "",
        "For NVM for Windows v1, use `versions/nvm1`."
    ],
    "innosetup": true,
    "architecture": {
        "64bit": {
            "url": "https://github.com/nvm-windows/nvm/releases/download/v2.0.0/nvm-2.0.0-amd64-setup.exe",
            "hash": "afaee67d3d7bc8ccad0b1b06f63b0f2d6b008bc7e55d5205043f095b4906ac11"
        },
        "arm64": {
            "url": "https://github.com/nvm-windows/nvm/releases/download/v2.0.0/nvm-2.0.0-arm64-setup.exe",
            "hash": "62868ba9d1fd0e9b60ad7f69d05e8e85b49b5700ec29cf6e9adb9a5c83aebdb7"
        }
    },
    "env_add_path": ".",
    "post_install": "Add-Path -Path \"$env:LOCALAPPDATA\\Author Software\\nvm\\.nodejs\" -Global:$global",
    "pre_uninstall": "Remove-Path -Path \"$env:LOCALAPPDATA\\Author Software\\nvm\\.nodejs\" -Global:$global",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nvm-windows/nvm/releases/download/v$version/nvm-$version-amd64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/nvm-windows/nvm/releases/download/v$version/nvm-$version-arm64-setup.exe"
            }
        }
    }
}
