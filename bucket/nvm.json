{
    "version": "2.0.1",
    "description": "A node.js version management utility for Windows.",
    "homepage": "https://github.com/nvm-windows/nvm",
    "license": "MIT",
    "notes": [
        "NVM for Windows v2 has been fully rewritten for modern workflows.",
        "v2 introduces significant changes to how data and settings are stored.",
        "Scoop will not migrate your existing v1 settings. You may need to reconfigure them manually.",
        "For more details, please refer to: https://docs.nvm-windows.com/features/newv2/",
        "",
        "For NVM for Windows v1, use `versions/nvm1`."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/nvm-windows/nvm/releases/download/v2.0.1/nvm-2.0.1-x64-setup.exe",
            "hash": "2ba6ab6290fdc7d1e608e76c97577ca6e1df772b2d59ab8ebc01e10788de8e57"
        },
        "arm64": {
            "url": "https://github.com/nvm-windows/nvm/releases/download/v2.0.1/nvm-2.0.1-arm64-setup.exe",
            "hash": "3006e073069e289a16561bdd20f56a8d785429536e87c5e9031e8cb57bef7f46"
        }
    },
    "innosetup": true,
    "post_install": [
        "Add-Path -Path \"$persist_dir\\.nodejs\" -Global:$global",
        "nvm config set root=\"$persist_dir\\nodejs\""
    ],
    "env_add_path": ".",
    "pre_uninstall": [
        "if (($cmd -eq 'uninstall') -and $purge -and !(is_admin)) {",
        "    # Warn about required admin privileges during purge without aborting uninstallation.",
        "    warn 'Purge may require administrative privileges.'",
        "}",
        "Remove-Path -Path \"$persist_dir\\.nodejs\" -Global:$global"
    ],
    "persist": "nodejs",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nvm-windows/nvm/releases/download/v$version/nvm-$version-x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/nvm-windows/nvm/releases/download/v$version/nvm-$version-arm64-setup.exe"
            }
        }
    }
}
