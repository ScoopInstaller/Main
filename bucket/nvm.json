{
    "version": "2.0.0",
    "description": "NVM for Windows has been fully rewritten for modern workflows.",
    "homepage": "https://github.com/nvm-windows/nvm",
    "license": "MIT",
    "notes": [
        "The 'nvm config' command now works by Windows registries,",
        "and no environmental variables are available so far.",
        "You may be interested in changing 'local_dir', 'node_mirror','npm_mirror','proxy', and 'root'",
        "do check https://docs.nvm-windows.com/cfg/registry/ for more details.",
        "For now the NodeJS installation folder cannot be used as a scoop persist dir."
    ],
    "innosetup": true,
    "architecture": {
        "64bit": {
            "url": "https://github.com/nvm-windows/nvm/releases/download/v2.0.0/nvm-2.0.0-amd64-setup.exe",
            "hash": "afaee67d3d7bc8ccad0b1b06f63b0f2d6b008bc7e55d5205043f095b4906ac11"
        },
        "arm64": {
            "url": "https://github.com/nvm-windows/nvm/releases/download/v2.0.0/nvm-2.0.0-arm64-setup.exe",
            "hash": "62868ba9d1fd0e9b60ad7f69d05e8e85b49b5700ec29cf6e9adb9a5c83aebdb7"
        }
    },
    "env_add_path": ".",
    "post_install": "Add-Path \"$env:LOCALAPPDATA\\Author Software\\nvm\\.nodejs\" $global",
    "pre_uninstall": "Remove-Path \"$env:LOCALAPPDATA\\Author Software\\nvm\\.nodejs\" $global",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nvm-windows/nvm/releases/download/v$version/nvm-$version-amd64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/nvm-windows/nvm/releases/download/v$version/nvm-$version-arm64-setup.exe"
            }
        }
    }
}
