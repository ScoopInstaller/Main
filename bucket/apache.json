{
    "version": "2.4.70",
    "description": "The Apache HTTP Server ('httpd')",
    "homepage": "https://www.apachelounge.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://fossies.org/windows/www/httpd-2.4.70-261106-Win64-VS18.zip",
            "hash": "b96a40b66a99428b2e4aea48ebe98bab826c768df4ace81f78dd7e26a98ad311"
        }
    },
    "extract_dir": "Apache24",
    "bin": [
        "bin\\ab.exe",
        "bin\\abs.exe",
        "bin\\htcacheclean.exe",
        "bin\\htdbm.exe",
        "bin\\htdigest.exe",
        "bin\\htpasswd.exe",
        "bin\\httpd.exe",
        "bin\\httxt2dbm.exe",
        "bin\\logresolve.exe",
        "bin\\rotatelogs.exe"
    ],
    "post_install": [
        "    # set directory in httpd.conf",
        "$conf = \"$dir\\conf\\httpd.conf\"",
        "$root= \"$dir\" -replace '\\\\', '/'",
        "((Get-Content $conf) -replace 'c:/Apache24', \"$root\") | Set-Content $conf"
    ],
    "persist": [
        "htdocs",
        "conf",
        "logs"
    ],
    "checkver": {
        "url": "https://fossies.org/windows/www/",
        "regex": "httpd-([\\d.]+)-(?<date>[\\d]+)-(?<arch>(w|W)in64)-(?<vs>VS\\d+)\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://fossies.org/windows/www/httpd-$version-$matchDate-$matchArch-$matchVs.zip"
            }
        },
        "hash": {
            "url": "$url_fossies.sha256"
        },
        "extract_dir": "Apache$majorVersion$minorVersion"
    }
}
