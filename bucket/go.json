{
    "version": "1.27.2",
    "description": "An open source programming language that makes it easy to build simple, reliable, and efficient software.",
    "homepage": "https://go.dev",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/go/go1.27.2.windows-amd64.zip",
            "hash": "1314008898bd40df77af4b014f777f08873dbdfbcd3d92308728ee03304fe04f"
        },
        "32bit": {
            "url": "https://dl.google.com/go/go1.27.2.windows-386.zip",
            "hash": "b41f5abfa012399752aea010839c8fd1f66283cd0ea83c864a7a9693ceff8fae"
        },
        "arm64": {
            "url": "https://dl.google.com/go/go1.27.2.windows-arm64.zip",
            "hash": "5c4b294f23b558619ae8a4aa94d023e3bca03f52c8398bb41b9026002b0013de"
        }
    },
    "extract_dir": "go",
    "installer": {
        "script": [
            "$first_entry = $env:GOPATH -split ';' | ForEach-Object { $_.Trim() } | Where-Object { $_ } | Select-Object -First 1",
            "$bin_path = if ($first_entry) { Join-Path $first_entry 'bin' } else { \"$env:USERPROFILE\\go\\bin\" }",
            "Add-Path -Path $bin_path -Global:$global -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$first_entry = $env:GOPATH -split ';' | ForEach-Object { $_.Trim() } | Where-Object { $_ } | Select-Object -First 1",
            "$bin_path = if ($first_entry) { Join-Path $first_entry 'bin' } else { \"$env:USERPROFILE\\go\\bin\" }",
            "Remove-Path -Path $bin_path -Global:$global"
        ]
    },
    "bin": [
        "bin\\go.exe",
        "bin\\gofmt.exe"
    ],
    "checkver": {
        "url": "https://go.dev/dl/",
        "regex": "go([\\d.]+)\\.windows-"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/go/go$version.windows-amd64.zip"
            },
            "32bit": {
                "url": "https://dl.google.com/go/go$version.windows-386.zip"
            },
            "arm64": {
                "url": "https://dl.google.com/go/go$version.windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
