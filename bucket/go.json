{
    "version": "1.27.0",
    "description": "An open source programming language that makes it easy to build simple, reliable, and efficient software.",
    "homepage": "https://go.dev",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/go/go1.27.0.windows-amd64.zip",
            "hash": "f0c0a0d33ba94f4d2c5dbc887334ce678b21813504ddb3aafcb06e60a5a667c4"
        },
        "32bit": {
            "url": "https://dl.google.com/go/go1.27.0.windows-386.zip",
            "hash": "009b767e3619b0e9b41eb66d1f1402c6db3e752bf0be1b3eaf200bb5b888efaa"
        },
        "arm64": {
            "url": "https://dl.google.com/go/go1.27.0.windows-arm64.zip",
            "hash": "6e0156b9788209931dd340fadc04171ce15063c17b51c92e7b86b51109626e90"
        }
    },
    "extract_dir": "go",
    "installer": {
        "script": [
            "$first_entry = ((\"$env:GOPATH\" -split ';').Trim() -ne '')[0]",
            "$bin_path = if ($first_entry) { Join-Path $first_entry 'bin' } else { \"$env:USERPROFILE\\go\\bin\" }",
            "Add-Path -Path $bin_path -Global:$global -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$first_entry = ((\"$env:GOPATH\" -split ';').Trim() -ne '')[0]",
            "$bin_path = if ($first_entry) { Join-Path $first_entry 'bin' } else { \"$env:USERPROFILE\\go\\bin\" }",
            "$global = installed $app $true",
            "Remove-Path -Path $bin_path -Global:$global"
        ]
    },
    "bin": [
        "bin\\go.exe",
        "bin\\gofmt.exe"
    ],
    "checkver": {
        "url": "https://go.dev/dl/",
        "regex": "go([\\d.]+)\\.windows-"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/go/go$version.windows-amd64.zip"
            },
            "32bit": {
                "url": "https://dl.google.com/go/go$version.windows-386.zip"
            },
            "arm64": {
                "url": "https://dl.google.com/go/go$version.windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
