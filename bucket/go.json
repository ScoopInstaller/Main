{
    "version": "1.27.4",
    "description": "An open source programming language that makes it easy to build simple, reliable, and efficient software.",
    "homepage": "https://go.dev",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/go/go1.27.4.windows-amd64.zip",
            "hash": "178ab98950ac69ab25069307dc6ade79f3816e414cce95b4da166a115cde1e7e"
        },
        "32bit": {
            "url": "https://dl.google.com/go/go1.27.4.windows-386.zip",
            "hash": "ef86c83de402573f0dea26727032e239906ca1ba4f42130ce21c02e789a687f8"
        },
        "arm64": {
            "url": "https://dl.google.com/go/go1.27.4.windows-arm64.zip",
            "hash": "9e7a72565792b8ab370b37ac9ac109799237abacb39ff2f541c438b963c0cc64"
        }
    },
    "extract_dir": "go",
    "installer": {
        "script": [
            "$first_entry = $env:GOPATH -split ';' | ForEach-Object { $_.Trim() } | Where-Object { $_ } | Select-Object -First 1",
            "$bin_path = if ($first_entry) { Join-Path $first_entry 'bin' } else { \"$env:USERPROFILE\\go\\bin\" }",
            "Add-Path -Path $bin_path -Global:$global -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$first_entry = $env:GOPATH -split ';' | ForEach-Object { $_.Trim() } | Where-Object { $_ } | Select-Object -First 1",
            "$bin_path = if ($first_entry) { Join-Path $first_entry 'bin' } else { \"$env:USERPROFILE\\go\\bin\" }",
            "Remove-Path -Path $bin_path -Global:$global"
        ]
    },
    "bin": [
        "bin\\go.exe",
        "bin\\gofmt.exe"
    ],
    "checkver": {
        "url": "https://go.dev/dl/",
        "regex": "go([\\d.]+)\\.windows-"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/go/go$version.windows-amd64.zip"
            },
            "32bit": {
                "url": "https://dl.google.com/go/go$version.windows-386.zip"
            },
            "arm64": {
                "url": "https://dl.google.com/go/go$version.windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
