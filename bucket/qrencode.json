                        "regex": "SHA256:.+\\s+<.+>$sha256"
                    },
                    {
                        "url": "https://packages.msys2.org/packages/mingw-w64-x86_64-zlib",
                        "regex": "SHA256:.+\\s+<.+>$sha256"
                    }
                ]
            }
        }
    }
