    "license": "Apache-2.0",
    "suggest": {
        "JDK": "java/openjdk"
    },
    "url": "https://github.com/apache/grails-core/releases/download/v8.0.0/apache-grails-8.0.0-bin.zip",
    "hash": "sha512:e39d2649be4d73e0b4ea3a35d7b3c51537f423330d44fc2a96727ae1732512308f0f18a2008132053819c5805802315fe263fcc16f5808af781a8087dcfd2754",
