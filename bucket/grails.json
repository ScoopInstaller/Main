    "bin": "bin\\grails.bat",
    "env_set": {
        "GRAILS_HOME": "$dir"
    },
    "checkver": {
        "github": "https://api.github.com/repos/apache/grails-core/releases",
        "jsonpath": "$[?(@.prerelease == false)].assets[?(@.name =~ /apache-grails-[\\d.]+-bin/i)].browser_download_url",
