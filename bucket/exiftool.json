    "homepage": "https://exiftool.org",
    "license": "GPL-1.0-or-later|Artistic-1.0-Perl",
    "architecture": {
        "64bit": {
            "url": "https://download.sourceforge.net/project/exiftool/exiftool-13.61_64.zip",
            "hash": "ab75b37515385a753aa60a58f68ffffe1ff81e43b319df9540978fb19e0580e5",
            "extract_dir": "exiftool-13.61_64"
        },
        "32bit": {
            "url": "https://download.sourceforge.net/project/exiftool/exiftool-13.61_32.zip",
            "hash": "fb5bcbf029a5be955ea46250923da936fdd54049f1023875928deb1cad3bdd58",
            "extract_dir": "exiftool-13.61_32"
        }
    },
    "pre_install": "Copy-Item \"$dir\\exiftool(-k).exe\" \"$dir\\exiftool.exe\"",
    "bin": [
        "exiftool.exe",
        "exiftool(-k).exe"
    ],
    "checkver": {
        "url": "https://exiftool.org/ver.txt",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.sourceforge.net/project/exiftool/exiftool-$version_64.zip",
                "extract_dir": "exiftool-$version_64"
            },
            "32bit": {
                "url": "https://download.sourceforge.net/project/exiftool/exiftool-$version_32.zip",
                "extract_dir": "exiftool-$version_32"
            }
        },
        "hash": {
            "url": "https://exiftool.org/checksums-$version.txt",
            "regex": "$basename.*?$sha256"
        }
    }
}
