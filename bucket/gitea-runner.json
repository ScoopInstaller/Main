{
    "version": "5.4.0",
    "description": "Official runner for Gitea Actions",
    "homepage": "https://gitea.com/gitea/runner",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://gitea.com/gitea/runner/releases/download/v5.4.0/gitea-runner-5.4.0-windows-amd64.exe.xz",
            "hash": "01ce7a95ff80f42229392cf75e3d9a9fc2780e23cedba7fa74d39e27b05e9eca"
        }
    },
    "pre_install": "Get-ChildItem -LiteralPath $dir -Filter 'gitea-runner-*.exe' -File | Select-Object -First 1 | Rename-Item -NewName 'gitea-runner.exe'",
    "bin": "gitea-runner.exe",
    "checkver": {
        "url": "https://gitea.com/gitea/runner/releases/latest",
        "regex": "/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gitea.com/gitea/runner/releases/download/v$version/gitea-runner-$version-windows-amd64.exe.xz"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
