            "hash": "2439f7e0fcf6488ef536d36e546629639b6f0ae9b3175682717745ad3bde93c1",
            "extract_dir": "PFiles64\\psqlODBC\\1800"
        },
        "32bit": {
            "url": "https://ftp.postgresql.org/pub/odbc/releases/REL-18_00_0004/psqlodbc_x86.msi",
