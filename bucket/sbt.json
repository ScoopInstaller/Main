{
    "version": "2.0.11",
    "description": "A build tool for Scala, Java, and more",
    "homepage": "https://www.scala-sbt.org",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sbt/sbt/releases/download/v2.0.11/sbt-2.0.11.zip",
            "hash": "3f05a41886c00e87adb81c8ca28c3aa3d430753a640e6c4e83642c0c7a8d59d9"
        }
    },
    "extract_dir": "sbt",
    "env_set": {
        "SBT_HOME": "$dir"
    },
    "bin": "bin\\sbt.bat",
    "persist": "conf",
    "checkver": {
        "github": "https://github.com/sbt/sbt"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sbt/sbt/releases/download/v$version/sbt-$version.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
