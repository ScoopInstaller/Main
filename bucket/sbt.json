{
    "version": "2.1.0",
    "description": "A build tool for Scala, Java, and more",
    "homepage": "https://www.scala-sbt.org",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sbt/sbt/releases/download/v2.1.0/sbt-2.1.0.zip",
            "hash": "1e1f306a7dea68a8b1960044ceb33174931d481e11b02bb70df179e703a40584"
        }
    },
    "extract_dir": "sbt",
    "env_set": {
        "SBT_HOME": "$dir"
    },
    "bin": "bin\\sbt.bat",
    "persist": "conf",
    "checkver": {
        "github": "https://github.com/sbt/sbt"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sbt/sbt/releases/download/v$version/sbt-$version.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
