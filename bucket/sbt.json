{
    "version": "2.0.12",
    "description": "A build tool for Scala, Java, and more",
    "homepage": "https://www.scala-sbt.org",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sbt/sbt/releases/download/v2.0.12/sbt-2.0.12.zip",
            "hash": "73f9c4a10584cde3d37d773e2b38d2fc4348c6cef8d88da8b7dd41e7d5f614d7"
        }
    },
    "extract_dir": "sbt",
    "env_set": {
        "SBT_HOME": "$dir"
    },
    "bin": "bin\\sbt.bat",
    "persist": "conf",
    "checkver": {
        "github": "https://github.com/sbt/sbt"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sbt/sbt/releases/download/v$version/sbt-$version.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
