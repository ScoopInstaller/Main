{
    "version": "2.0.6",
    "description": "A build tool for Scala, Java, and more",
    "homepage": "https://www.scala-sbt.org",
    "license": "BSD-3-Clause",
    "url": "https://github.com/sbt/sbt/releases/download/v2.0.6/sbt-2.0.6.zip",
    "hash": "5ed304a007159ac37e002111e364366fa1518a75d8023309443ad320ed306266",
    "extract_dir": "sbt",
    "env_set": {
        "SBT_HOME": "$dir"
    },
    "bin": "bin\\sbt.bat",
    "persist": "conf",
    "checkver": {
        "url": "https://www.scala-sbt.org/download/",
        "regex": "/sbt-([\\d.]+)\\.zip"
    },
    "autoupdate": {
        "url": "https://github.com/sbt/sbt/releases/download/v$version/sbt-$version.zip",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
