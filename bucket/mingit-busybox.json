{
    "version": "2.56.1",
    "description": "Minimal Git for Windows (MinGit) is a reduced sized package designed to support application integration (like integrated development environments, graph visualizers, etc.) where full console support (colorization, pagniation, etc.) is not needed.(BusyBox-backed MinGit, experimental, smaller version of MinGit)",
    "homepage": "https://git-for-windows.github.io/",
    "license": "GPL-2.0-only",
    "notes": [
        "To get Git to recognise OpenSSH, you will need to run",
        "",
        "scoop install openssh",
        "[environment]::setenvironmentvariable('GIT_SSH', (resolve-path (scoop which ssh)), 'USER')",
        "",
        "and then restart powershell."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/git-for-windows/git/releases/download/v2.56.1.windows.1/MinGit-2.56.1-busybox-64-bit.zip",
            "hash": "baa40c1b8d5897826f47c2b819156553b89833bc52cb42cdfca7d1f0faeed34a",
            "bin": [
                "cmd\\git.exe",
                "ucrt64\\bin\\busybox.exe"
            ]
        },
        "32bit": {
            "url": "https://github.com/git-for-windows/git/releases/download/v2.56.1.windows.1/MinGit-2.56.1-busybox-32-bit.zip",
            "hash": "125c9cb25499e27f66bc5c8357ac74fd4bc8b104ee45054d741aeb2bd0fffe60",
            "bin": [
                "cmd\\git.exe",
                "mingw32\\bin\\busybox.exe"
            ]
        },
        "arm64": {
            "url": "https://github.com/git-for-windows/git/releases/download/v2.56.1.windows.1/MinGit-2.56.1-busybox-arm64.zip",
            "hash": "42396e389d1b38861fea05edc716b2389e071008c44dd62a53ba05bb85f65494",
            "bin": [
                "cmd\\git.exe",
                "clangarm64\\bin\\busybox.exe"
            ]
        }
    },
    "env_set": {
        "GIT_INSTALL_ROOT": "$dir"
    },
    "checkver": {
        "github": "https://api.github.com/repos/git-for-windows/git/releases/latest",
        "jsonpath": "$..browser_download_url",
        "regex": "download/v(?<tag>[\\d.]+windows\\.\\d)/MinGit-([\\d.]+)-busybox-64"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/git-for-windows/git/releases/download/v$matchTag/MinGit-$version-busybox-64-bit.zip"
            },
            "32bit": {
                "url": "https://github.com/git-for-windows/git/releases/download/v$matchTag/MinGit-$version-busybox-32-bit.zip"
            },
            "arm64": {
                "url": "https://github.com/git-for-windows/git/releases/download/v$matchTag/MinGit-$version-busybox-arm64.zip"
            }
        },
        "hash": {
            "url": "https://github.com/git-for-windows/git/releases/tag/v$matchTag",
            "regex": "(?s)$basename.*?$sha256"
        }
    }
}
