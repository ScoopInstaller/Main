{
    "version": "0.4.5",
    "description": "Desktop Android leak auditor that maps app permissions and APK endpoints to data flows and generates rollback-safe remediations over adb.",
    "homepage": "https://verlintas.dev/noir/",
    "license": "MIT",
    "depends": "adb",
    "suggest": {
        "jadx": "extras/jadx"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Verlintas/NOIR/releases/download/v0.4.5/noir-v0.4.5-Windows-portable.zip",
            "hash": "3ddf9b17f1b51fea8d557d67076d436f25a154baa29861b75d3458296eaca5d9"
        }
    },
    "bin": [
        [
            "Start NOIR.bat",
            "noir"
        ]
    ],
    "persist": "noir-out",
    "checkver": {
        "github": "https://github.com/Verlintas/NOIR"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Verlintas/NOIR/releases/download/v$version/noir-v$version-Windows-portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
