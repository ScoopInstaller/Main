{
    "version": "0.4.3",
    "description": "Desktop Android leak auditor that maps app permissions and APK endpoints to data flows and generates rollback-safe remediations over adb.",
    "homepage": "https://verlintas.dev/noir/",
    "license": "MIT",
    "depends": "adb",
    "suggest": {
        "jadx": "extras/jadx"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Verlintas/NOIR/releases/download/v0.4.3/noir-v0.4.3-Windows-portable.zip",
            "hash": "b8de3808bc450f3890e1f12f6cc4686bc0918516d56d2736d1e516bed6ef0ce2"
        }
    },
    "bin": [
        [
            "Start NOIR.bat",
            "noir"
        ]
    ],
    "persist": "noir-out",
    "checkver": {
        "github": "https://github.com/Verlintas/NOIR"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Verlintas/NOIR/releases/download/v$version/noir-v$version-Windows-portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
