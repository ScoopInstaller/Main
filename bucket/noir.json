{
    "version": "0.4.2",
    "description": "Desktop Android leak auditor that maps app permissions and APK endpoints to data flows and generates rollback-safe remediations over adb.",
    "homepage": "https://verlintas.dev/noir/",
    "license": "MIT",
    "depends": "adb",
    "suggest": {
        "jadx": "extras/jadx"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Verlintas/NOIR/releases/download/v0.4.2/noir-v0.4.2-Windows-portable.zip",
            "hash": "e79a0cb2b859b838a328a05c88e106b375056dc2c8ed70a122d6b68a878c13c7"
        }
    },
    "bin": [
        [
            "Start NOIR.bat",
            "noir"
        ]
    ],
    "persist": "noir-out",
    "checkver": {
        "github": "https://github.com/Verlintas/NOIR"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Verlintas/NOIR/releases/download/v$version/noir-v$version-Windows-portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
