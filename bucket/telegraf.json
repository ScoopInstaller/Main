    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://dl.influxdata.com/telegraf/releases/telegraf-1.40.3_windows_amd64.zip",
            "hash": "273867d9bb070625b8fc8627f3189899b1221c2c6540dd98f6e526108a89c9c3"
        },
        "32bit": {
            "url": "https://dl.influxdata.com/telegraf/releases/telegraf-1.40.3_windows_i386.zip",
            "hash": "4c99879a5fe1384587f29919c1e899c02b2c51486935ecf20c6a2eaebe84d0a5"
        },
        "arm64": {
            "url": "https://dl.influxdata.com/telegraf/releases/telegraf-1.40.3_windows_arm64.zip",
            "hash": "7414adef8d77866da88af0432ade14603db61926e42b32f7c5dbacab84010ec7"
        }
    },
    "extract_dir": "telegraf-1.40.3",
    "bin": "telegraf.exe",
    "persist": "telegraf.conf",
    "env_set": {
        "TELEGRAF_CONFIG_PATH": "$persist_dir/telegraf.conf"
    },
    "checkver": {
        "github": "https://github.com/influxdata/telegraf"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.influxdata.com/telegraf/releases/telegraf-$version_windows_amd64.zip"
            },
            "32bit": {
                "url": "https://dl.influxdata.com/telegraf/releases/telegraf-$version_windows_i386.zip"
            },
            "arm64": {
                "url": "https://dl.influxdata.com/telegraf/releases/telegraf-$version_windows_arm64.zip"
            }
        },
        "hash": {
            "url": "https://github.com/influxdata/telegraf/releases/tag/v$version",
            "regex": "(?s)$basename</.*?<\\w+>$sha256</"
        },
        "extract_dir": "telegraf-$version"
    }
}
