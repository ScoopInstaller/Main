{
    "version": "13.5.0",
    "description": "A parallel computing platform and programming model invented by NVIDIA",
    "homepage": "https://developer.nvidia.com/cuda-toolkit",
    "license": {
        "identifier": "Freeware",
        "url": "https://docs.nvidia.com/cuda/eula/index.html"
    },
    "notes": [
        "To enable CUDA support in CMake for MSVC, specify the CUDA toolkit directory using the generator toolset flag:",
        "-DCMAKE_GENERATOR_TOOLSET=\"cuda=$dir\""
    ],
    "architecture": {
        "64bit": {
            "url": "https://developer.download.nvidia.com/compute/cuda/13.5.0/local_installers/cuda_13.5.0_windows_x86_64.exe#/dl.7z",
            "hash": "md5:7edd4d268e61571e06fe13acb676ce0d",
            "env_add_path": [
                "bin",
                "bin\\x64"
            ]
        },
        "arm64": {
            "url": "https://developer.download.nvidia.com/compute/cuda/13.5.0/local_installers/cuda_13.5.0_windows_arm64.exe#/dl.7z",
            "hash": "md5:f7eb876fe50ec432ab36b139eda8e3f6",
            "env_add_path": [
                "bin",
                "bin\\arm64"
            ]
        }
    },
    "installer": {
        "script": [
            "$names = @('bin', 'extras', 'include', 'lib', 'nvml', 'nvvm', 'compute-sanitizer', 'src', 'tools')",
            "foreach ($name in $names) {",
            "    Copy-Item \"$dir\\cuda_*\\*\\$name\" \"$dir\" -Recurse -Force",
            "    Copy-Item \"$dir\\lib*\\*\\$name\" \"$dir\" -Recurse -Force",
            "    Copy-Item \"$dir\\cccl\\*\\$name\" \"$dir\" -Recurse -Force",
            "    Copy-Item \"$dir\\visual_studio_integration\\*\\$name\" \"$dir\" -Recurse -Force",
            "}",
            "Get-ChildItem \"$dir\" -Exclude $names | Remove-Item -Recurse -Force"
        ]
    },
    "env_set": {
        "CUDA_PATH": "$dir"
    },
    "checkver": {
        "url": "https://developer.nvidia.com/cuda-downloads?target_os=Windows&target_arch=x86_64&target_version=10&target_type=exe_local",
        "regex": "/cuda_([\\d._]+)_windows_x86_64\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://developer.download.nvidia.com/compute/cuda/$matchHead/local_installers/cuda_$version_windows_x86_64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://developer.download.nvidia.com/compute/cuda/$matchHead/local_installers/cuda_$version_windows_arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://developer.download.nvidia.com/compute/cuda/$matchHead/docs/sidebar/md5sum.txt"
        }
    }
}
