{
    "version": "23.1.5",
    "description": "Collection of modular and reusable compiler and toolchain technologies. (arm64/aarch64 only)",
    "homepage": "https://www.llvm.org",
    "license": "NCSA",
    "architecture": {
        "arm64": {
            "url": "https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.5/LLVM-23.1.5-woa64.msi",
            "hash": "0e8a80e8c8a9a17958e65ec706b62fd07b172792bccfed54a32006e1823a79b7"
        }
    },
    "extract_dir": "LLVM",
    "env_add_path": "bin",
    "env_set": {
        "LIBCLANG_PATH": "$dir\\bin",
        "LLVM_LIB_DIR": "$dir\\lib"
    },
    "checkver": {
        "github": "https://github.com/llvm/llvm-project",
        "regex": "llvmorg-([\\d._]+)"
    },
    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/LLVM-$version-woa64.msi"
            }
        }
    }
}
