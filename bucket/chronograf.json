            }
        },
        "hash": {
            "url": "https://portal.influxdata.com/downloads/",
            "regex": "\"sha256\"\\s*:\\s*\"$sha256\"[^}]*$basename"
        },
        "extract_dir": "chronograf-$version-1"
    }
