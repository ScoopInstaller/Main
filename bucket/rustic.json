{
    "version": "0.12.0",
    "description": "fast, encrypted, and deduplicated backups powered by Rust",
    "homepage": "https://rustic.cli.rs",
    "license": "MIT|Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/rustic-rs/rustic/releases/download/v0.12.0/rustic-v0.12.0-x86_64-pc-windows-msvc.tar.gz",
            "hash": "792bb1ecf32b9a01144f0316b5c1cb1e3e23fc20a8d9c2362e067d266e6ddfc9"
        }
    },
    "env_set": {
        "RUSTIC_HOME": "$dir"
    },
    "bin": "rustic.exe",
    "persist": [
        "config",
        "logs"
    ],
    "checkver": {
        "github": "https://github.com/rustic-rs/rustic"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rustic-rs/rustic/releases/download/v$version/rustic-v$version-x86_64-pc-windows-msvc.tar.gz"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
