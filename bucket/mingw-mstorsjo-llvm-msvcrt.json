{
    "version": "23.1.6-20261117",
    "description": "LLVM toolchain based on mingw-w64. (MSVCRT, mstorsjo build)",
    "homepage": "https://github.com/mstorsjo/llvm-mingw/",
    "license": "GPL-3.0-or-later,ZPL-2.1,Apache-2.0 WITH LLVM-exception,ISC",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mstorsjo/llvm-mingw/releases/download/20261117/llvm-mingw-20261117-msvcrt-x86_64.zip",
            "hash": "17db10bd2c0bcbf55e5e4382475190165d0fc90dfe52ca165a51f1dfb1ca19c8",
            "extract_dir": "llvm-mingw-20261117-msvcrt-x86_64"
        },
        "32bit": {
            "url": "https://github.com/mstorsjo/llvm-mingw/releases/download/20261117/llvm-mingw-20261117-msvcrt-i686.zip",
            "hash": "fdc7eaf19cca9470bab225027dd875bdad432dba9e152b46b0f6da9cf3506081",
            "extract_dir": "llvm-mingw-20261117-msvcrt-i686"
        }
    },
    "post_install": "Copy-Item \"$dir\\bin\\mingw32-make.exe\" \"$dir\\bin\\make.exe\"",
    "env_add_path": "bin",
    "checkver": {
        "github": "https://github.com/mstorsjo/llvm-mingw",
        "jsonpath": "$..name",
        "regex": "llvm-mingw\\s+(?<time>\\d+)\\swith\\s+LLVM\\s+(?<llvm>[\\d.]+)",
        "replace": "${llvm}-${time}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mstorsjo/llvm-mingw/releases/download/$matchTime/llvm-mingw-$matchTime-msvcrt-x86_64.zip",
                "extract_dir": "llvm-mingw-$matchTime-msvcrt-x86_64"
            },
            "32bit": {
                "url": "https://github.com/mstorsjo/llvm-mingw/releases/download/$matchTime/llvm-mingw-$matchTime-msvcrt-i686.zip",
                "extract_dir": "llvm-mingw-$matchTime-msvcrt-i686"
            }
        }
    }
}
