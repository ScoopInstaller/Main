{
    "version": "9.3.3",
    "description": "A fast, scalable, multi-language and extensible build system",
    "homepage": "https://bazel.build",
    "license": "Apache-2.0",
    "suggest": {
        "MSYS2": "msys2",
        "Python27": "versions/python27",
        "curl": "curl"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/bazelbuild/bazel/releases/download/9.3.3/bazel-9.3.3-windows-x86_64.zip",
            "hash": "d5a7fa55a9c5750c2b6c47d83b7892b9934c3fdd02e19fac2dc012194d64b69a"
        },
        "arm64": {
            "url": "https://github.com/bazelbuild/bazel/releases/download/9.3.3/bazel-9.3.3-windows-arm64.zip",
            "hash": "3f1d93b9ac1e458bf008e8a98458742c3fd351473358f19ce62ed9652fea4833"
        }
    },
    "bin": "bazel.exe",
    "env_set": {
        "BAZEL_SH": "$(appdir msys2 $global)\\current\\usr\\bin\\bash.exe"
    },
    "checkver": {
        "github": "https://github.com/bazelbuild/bazel"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bazelbuild/bazel/releases/download/$version/bazel-$version-windows-x86_64.zip"
            },
            "arm64": {
                "url": "https://github.com/bazelbuild/bazel/releases/download/$version/bazel-$version-windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
