{
    "version": "6.4.2",
    "description": "A general-purpose programming language built using a modern approach to safety, performance, and software design patterns.",
    "homepage": "https://www.swift.org/",
    "license": "Apache-2.0",
    "notes": [
        "* Known issue:",
        "  - 'swift.exe' may not working with Junction, check workaround: https://github.com/ScoopInstaller/Main/issues/6159",
        "------",
        "To make Swift toolchain work, you must have Visual Studio and Windows SDK components installed.",
        "Read https://www.swift.org/getting-started/#support-files for Supporting Files installation guide."
    ],
    "suggest": {
        "python": "versions/python39",
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.swift.org/swift-6.4.2-release/windows10/swift-6.4.2-RELEASE/swift-6.4.2-RELEASE-windows10.exe",
            "hash": "8fe5d31ca1153dfe6be3a76de0b93347fd42a27599671e9f9ade23a3648e7184"
        },
        "arm64": {
            "url": "https://download.swift.org/swift-6.4.2-release/windows10-arm64/swift-6.4.2-RELEASE/swift-6.4.2-RELEASE-windows10-arm64.exe",
            "hash": "e4e5fdb6ca88b18ac430fbce3de35dd80e2249a84a484a02272d82d89f2c7969"
        }
    },
    "pre_install": [
        "Expand-DarkArchive \"$dir\\$fname\" \"$dir\\extract_folder\"",
        "$extract = \"$dir\\extract_folder\"",
        "$attached = \"$extract\\AttachedContainer\"",
        "$xml = [xml](Get-Content -Raw \"$extract\\UX\\manifest.xml\" -Encoding utf8)",
        "# Some Burn bundles contain multiple attached containers; dark only extracts the first.",
        "$containers = @($xml.BurnManifest.Container | Sort-Object { [int]$_.AttachedIndex })",
        "$requiredContainerIds = @($containers | Where-Object { $container = $_; @($xml.BurnManifest.Payload | Where-Object { $_.Container -eq $container.Id -and $_.FilePath -like \"*.msi\" -and $_.FilePath -notlike \"*.noasserts.msi\" }).Count -gt 0 } | ForEach-Object Id)",
        "$containerDirs = @(Get-ChildItem $extract -Directory | Where-Object { $_.Name -notin @(\"UX\", \"AttachedContainer\") })",
        "if ($containerDirs) {",
        "    New-Item -ItemType Directory -Path $attached -Force | Out-Null",
        "    $containerDirs | ForEach-Object { Get-ChildItem $_.FullName -File | Move-Item -Destination $attached -Force }",
        "} else {",
        "    $stream = [IO.File]::OpenRead(\"$dir\\$fname\")",
        "    $reader = [IO.BinaryReader]::new($stream)",
        "    try {",
        "        $stream.Position = 0x3c",
        "        $peOffset = $reader.ReadUInt32()",
        "        $stream.Position = $peOffset + 6",
        "        $sectionCount = $reader.ReadUInt16()",
        "        $stream.Position = $peOffset + 20",
        "        $optionalHeaderSize = $reader.ReadUInt16()",
        "        $sectionOffset = [int64]$peOffset + 24 + $optionalHeaderSize",
        "        $engineOffset = 0",
        "        for ($i = 0; $i -lt $sectionCount -and !$engineOffset; $i++) {",
        "            $stream.Position = $sectionOffset + 40 * $i",
        "            $sectionName = [Text.Encoding]::ASCII.GetString($reader.ReadBytes(8)).Trim([char]0)",
        "            if ($sectionName -eq \".wixburn\") {",
        "                $stream.Position += 12",
        "                $wixburnOffset = $reader.ReadUInt32()",
        "                $stream.Position = $wixburnOffset + 24",
        "                $stubSize = $reader.ReadUInt32()",
        "                $stream.Position = $wixburnOffset + 32",
        "                $signatureOffset = $reader.ReadUInt32()",
        "                $signatureSize = $reader.ReadUInt32()",
        "                if ($signatureOffset) { $engineOffset = [int64]$signatureOffset + $signatureSize } else { $stream.Position = $wixburnOffset + 48; $engineOffset = [int64]$stubSize + $reader.ReadUInt32() }",
        "            }",
        "        }",
        "        if (!$engineOffset) { abort \"Unable to locate the Burn engine in $dir\\$fname.\" }",
        "        $offset = $engineOffset",
        "        $containers | ForEach-Object {",
        "            $container = $_",
        "            $firstPayload = $xml.BurnManifest.Payload | Where-Object { $_.Container -eq $container.Id } | Select-Object -First 1",
        "            if (($requiredContainerIds -contains $container.Id) -and !(Test-Path \"$attached\\$($firstPayload.FilePath)\")) {",
        "                $cab = \"$extract\\container-$($container.AttachedIndex).cab\"",
        "                $stream.Position = $offset",
        "                $output = [IO.File]::Create($cab)",
        "                try {",
        "                    $remaining = [int64]$container.FileSize",
        "                    $buffer = New-Object byte[] (1MB)",
        "                    while ($remaining -gt 0) {",
        "                        $read = $stream.Read($buffer, 0, [Math]::Min($buffer.Length, $remaining))",
        "                        if (!$read) { abort \"Unexpected end of $dir\\$fname.\" }",
        "                        $output.Write($buffer, 0, $read)",
        "                        $remaining -= $read",
        "                    }",
        "                } finally {",
        "                    $output.Dispose()",
        "                }",
        "                Expand-7zipArchive $cab $attached -Removal",
        "            }",
        "            $offset += [int64]$container.FileSize",
        "        }",
        "    } finally {",
        "        $reader.Dispose()",
        "        $stream.Dispose()",
        "    }",
        "}",
        "$xml.BurnManifest.Payload | ForEach-Object {",
        "    $sourcePath = \"$attached\\$($_.SourcePath)\"",
        "    if (Test-Path $sourcePath) { Move-Item $sourcePath \"$attached\\$($_.FilePath)\" -Force }",
        "}",
        "# The install layout uses the assertions toolchain; ignore the noasserts payloads.",
        "$xml.BurnManifest.Payload | Where-Object { $_.FilePath -like \"*.msi\" -and $_.FilePath -notlike \"*.noasserts.msi\" } | ForEach-Object {",
        "    if ($_.FilePath -like \"rtl.*.msi\") {",
        "        Expand-MsiArchive \"$attached\\$($_.FilePath)\" \"$extract\\LocalApp\\Programs\\Swift\\Runtimes\\usr\\bin\"",
        "    } else {",
        "        Expand-MsiArchive \"$attached\\$($_.FilePath)\" $extract",
        "    }",
        "}",
        "$ver = $xml.BurnManifest.Registration.Version",
        "Move-Item -Path \"$extract\\LocalApp\\Programs\\Swift\" -Destination $dir",
        "Move-Item -Path \"$dir\\Swift\\Platforms\\$ver\\Windows.platform\" -Destination \"$dir\\Swift\\Platforms\"",
        "Move-Item -Path \"$dir\\Swift\\Toolchains\\$($ver)+Asserts\\usr\" -Destination \"$dir\\Swift\\Toolchains\"",
        "# Move-Item -Path \"$dir\\Swift\\Tools\\$ver\\*\" -Destination \"$dir\\Swift\\Tools\"",
        "Remove-Item \"$dir\\Swift\\Platforms\\$ver\" -Recurse | Out-Null",
        "Remove-Item \"$dir\\Swift\\Toolchains\\$ver+Asserts\" -Recurse | Out-Null",
        "# Remove-Item \"$dir\\Swift\\Tools\\$ver\" -Recurse | Out-Null",
        "Move-Item -Path \"$dir\\Swift\\*\" -Destination $dir",
        "Remove-Item \"$dir\\Swift\", $extract, \"$dir\\$fname\" -Recurse | Out-Null"
    ],
    "env_add_path": [
        "Runtimes\\usr\\bin",
        "Toolchains\\usr\\bin"
    ],
    "env_set": {
        "SDKROOT": "$dir\\Platforms\\Windows.platform\\Developer\\SDKs\\Windows.sdk"
    },
    "checkver": {
        "github": "https://github.com/swiftlang/swift",
        "regex": "swift-([\\d.]+)-RELEASE"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.swift.org/swift-$version-release/windows10/swift-$version-RELEASE/swift-$version-RELEASE-windows10.exe"
            },
            "arm64": {
                "url": "https://download.swift.org/swift-$version-release/windows10-arm64/swift-$version-RELEASE/swift-$version-RELEASE-windows10-arm64.exe"
            }
        }
    }
}
