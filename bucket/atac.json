            "hash": "812e604bd0bc6c56412aac715a80095d7d46c5e5830a8df2766b31f6c414a434"
        },
        "arm64": {
            "url": "https://github.com/Julien-cpsn/ATAC/releases/download/v0.23.1/atac-v0.23.1-aarch64-pc-windows-msvc.zip",
            "hash": "fde7df3809523e148b9ad074376dde010a0c75ce76656ba8213b470af8a05bde"
        }
    },
    "env_set": {
        "ATAC_MAIN_DIR": "$persist_dir\\config"
    },
    "bin": "atac.exe",
    "persist": "config",
    "checkver": {
        "github": "https://github.com/Julien-cpsn/ATAC"
    },
    "autoupdate": {
