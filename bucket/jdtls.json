    "license": "EPL-2.0",
    "suggest": {
        "JDK": "java/openjdk",
        "Python": "python"
    },
    "url": "https://download.eclipse.org/jdtls/snapshots/jdt-language-server-1.63.0-202610161536.tar.gz",
    "hash": "214656b27ff78e677c336d7fd2966cd154f01837ba37522c51d4a30feb15914d",
    "installer": {
        "script": "shim (Get-Command 'python.exe').Source $global jdtls \"$dir\\bin\\jdtls\""
    },
    "uninstaller": {
        "script": "rm_shim jdtls (shimdir $global) jdtls"
    },
    "checkver": {
        "url": "https://download.eclipse.org/jdtls/snapshots/latest.txt",
        "regex": "jdt-language-server-([\\d.]+)-(\\d+)",
        "replace": "${1}-${2}"
    },
    "autoupdate": {
        "url": "https://download.eclipse.org/jdtls/snapshots/jdt-language-server-$match1-$match2.tar.gz",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
