{
    "version": "1.62.0-202609282153",
    "description": "Java language server",
    "homepage": "https://projects.eclipse.org/projects/eclipse.jdt.ls",
    "license": "EPL-2.0",
    "suggest": {
        "JDK": "java/openjdk",
        "Python": "python"
    },
    "url": "https://download.eclipse.org/jdtls/snapshots/jdt-language-server-1.62.0-202609282153.tar.gz",
    "hash": "d1d09e812d1f29655f341544fb117e9c68aa8b46a3fe13dce16b3a4294e80fac",
    "installer": {
        "script": "shim (Get-Command 'python.exe').Source $global jdtls \"$dir\\bin\\jdtls\""
    },
    "uninstaller": {
        "script": [
            "$global = installed $app $true",
            "rm_shim jdtls (shimdir $global) jdtls"
        ]
    },
    "checkver": {
        "url": "https://download.eclipse.org/jdtls/snapshots/latest.txt",
        "regex": "jdt-language-server-([\\d.]+)-(\\d+)",
        "replace": "${1}-${2}"
    },
    "autoupdate": {
        "url": "https://download.eclipse.org/jdtls/snapshots/jdt-language-server-$match1-$match2.tar.gz",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
