{
    "version": "0.14.0",
    "description": "SkyWalking CLI is a command interaction tool for the SkyWalking user or OPS team",
    "homepage": "https://skywalking.apache.org/",
    "license": "Apache-2.0",
    "url": "https://downloads.apache.org/skywalking/cli/0.14.0/skywalking-cli-0.14.0-bin.tgz",
    "hash": "sha512:0065849e8d88934a9f00301f07cf336dc73aa69c6733c8c26845f76827403cc702c44cc7629e41c7b79c94e51cdee3497224be8e96f848e3ba4d666ffb8e39f2",
    "extract_dir": "skywalking-cli-0.14.0-bin",
    "bin": "bin\\swctl.exe",
    "pre_install": [
        "$bin_name = if ($architecture -eq '64bit') {'amd64'} else {'386'}",
        "Rename-Item \"$dir\\bin\\swctl-$version-windows-$bin_name\" \"swctl.exe\"",
        "Remove-Item \"$dir\\bin\\swctl-*\"",
        "Get-ChildItem -Path \"$dir\" \"._*\" -Recurse | Remove-Item"
    ],
    "checkver": {
        "url": "https://skywalking.apache.org/downloads",
        "regex": "cli/(\\d+(?:\\.\\d+)+)/skywalking-cli"
    },
    "autoupdate": {
        "url": "https://downloads.apache.org/skywalking/cli/$version/skywalking-cli-$version-bin.tgz",
        "hash": {
            "url": "$url.sha512"
        },
        "extract_dir": "skywalking-cli-$version-bin"
    }
}
