    "bin": "acli.exe",
    "checkver": {
        "url": "https://raw.githubusercontent.com/atlassian/homebrew-acli/main/Formula/acli.rb",
        "regex": "version \"([\\d.]+)-stable\""
    },
    "autoupdate": {
