            "hash": "f2075f6e5f6c025cfefa9d00cca8b073ad995a1b48a293eea8b6e7cabcbc1035",
            "extract_dir": "acli_1.3.40-stable_windows_amd64"
        },
        "arm64": {
            "url": "https://acli.atlassian.com/windows/1.3.40-stable/acli_1.3.40-stable_windows_arm64.zip",
