    "license": {
        "identifier": "Proprietary",
        "url": "https://developer.atlassian.com/platform/marketplace/atlassian-developer-terms/"
    },
    "architecture": {
        "64bit": {
            "url": "https://acli.atlassian.com/windows/1.3.23-stable/acli_1.3.23-stable_windows_amd64.zip",
            "hash": "51af89452bcab97bb6ae71c80495b536e1ecc3b6dc95d5e7a80ffa3270ec4630",
            "extract_dir": "acli_1.3.23-stable_windows_amd64"
        },
        "arm64": {
            "url": "https://acli.atlassian.com/windows/1.3.23-stable/acli_1.3.23-stable_windows_arm64.zip",
            "hash": "182d30a4b48f6344a55e8afe58918b03545a09bc81131b40092b024224ffa15d",
            "extract_dir": "acli_1.3.23-stable_windows_arm64"
        }
    },
    "bin": "acli.exe",
    "checkver": {
        "url": "https://raw.githubusercontent.com/atlassian/homebrew-acli/main/Formula/acli.rb",
        "regex": "version \"([\\d.]+)-stable\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://acli.atlassian.com/windows/$version-stable/acli_$version-stable_windows_amd64.zip",
                "extract_dir": "acli_$version-stable_windows_amd64"
            },
            "arm64": {
                "url": "https://acli.atlassian.com/windows/$version-stable/acli_$version-stable_windows_arm64.zip",
                "extract_dir": "acli_$version-stable_windows_arm64"
            }
        }
    }
}
