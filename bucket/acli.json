                "extract_dir": "acli_$version-stable_windows_amd64"
            },
            "arm64": {
                "url": "https://acli.atlassian.com/windows/$version-stable/acli_$version-stable_windows_arm64.zip",
                "extract_dir": "acli_$version-stable_windows_arm64"
            }
        }
    }
}
