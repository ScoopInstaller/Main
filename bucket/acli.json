            "hash": "a7454d84af6b83a192e98c337c08a0c00ef0450e2485100cebb20b3672095ca3",
            "extract_dir": "acli_1.3.36-stable_windows_amd64"
        },
        "arm64": {
            "url": "https://acli.atlassian.com/windows/1.3.36-stable/acli_1.3.36-stable_windows_arm64.zip",
