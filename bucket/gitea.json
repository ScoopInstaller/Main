{
    "version": "28.1.0",
    "description": "A painless self-hosted Git service",
    "homepage": "https://gitea.io/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://dl.gitea.com/gitea/28.1.0/gitea-28.1.0-windows-amd64.exe.xz",
            "hash": "373c0e216780dd983723af4eb542151e5f621389edc29e3b14a95f9e4977691f"
        },
        "arm64": {
            "url": "https://dl.gitea.com/gitea/28.1.0/gitea-28.1.0-windows-arm64.exe.xz",
            "hash": "f788b3778a10d4918c6108917d9787aa0b3e5012f7041c907b5471c3d05f9ac0"
        }
    },
    "installer": {
        "script": [
            "Get-Item \"$dir\\gitea*.exe\" | Rename-Item -NewName 'gitea.exe'",
            "if (!(Test-Path \"$persist_dir\\custom\\conf\")) {",
            "   New-Item \"$persist_dir\\custom\\conf\" -ItemType Directory | Out-Null",
            "}",
            "if (!(Test-Path \"$persist_dir\\custom\\conf\\app.ini\")) {",
            "   @(",
            "       '[database]'",
            "       'DB_TYPE = sqlite3'",
            "       \"PATH = $persist_dir/data/gitea.db\"",
            "       '[repository]'",
            "       \"ROOT = $persist_dir/repositories\"",
            "       '[log]'",
            "       \"ROOT_PATH = $persist_dir/log\"",
            "   ) -replace '\\\\', '/' | Set-Content \"$persist_dir\\custom\\conf\\app.ini\" -Encoding ASCII",
            "}"
        ]
    },
    "bin": "gitea.exe",
    "persist": [
        "custom",
        "repositories",
        "log",
        "data"
    ],
    "checkver": {
        "url": "https://dl.gitea.com/gitea/version.json",
        "jsonpath": "$.latest.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.gitea.com/gitea/$version/gitea-$version-windows-amd64.exe.xz"
            },
            "arm64": {
                "url": "https://dl.gitea.com/gitea/$version/gitea-$version-windows-arm64.exe.xz"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
